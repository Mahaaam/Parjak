{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/VIEW/index.html" },
    { "source": "/catalog.js", "destination": "/VIEW/catalog.js" },
    { "source": "/catalog.json", "destination": "/VIEW/catalog.json" },
    { "source": "/img/:path*", "destination": "/VIEW/img/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
